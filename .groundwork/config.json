{
  "specDir": "docs/specs",
  "testGlobs": ["packages/*/test/**", "analysis/tests/**"],
  "onEdit": [
    { "glob": "packages/*.ts", "run": "pnpm exec oxfmt {file} && pnpm exec oxlint --type-aware --deny-warnings {file}" },
    { "glob": "packages/*.mjs", "run": "pnpm exec oxfmt {file} && pnpm exec oxlint --deny-warnings {file}" },
    { "glob": "scripts/*.mjs", "run": "pnpm exec oxfmt {file} && pnpm exec oxlint --deny-warnings {file}" },
    { "glob": "analysis/*.py", "run": ".venv/bin/ruff format {file} && .venv/bin/ruff check {file}" }
  ],
  "onStop": "sh scripts/groundwork-checks.sh",
  "sources": {
    "tier1": [
      "code.claude.com",
      "docs.anthropic.com",
      "github.com",
      "nodejs.org",
      "www.typescriptlang.org",
      "vitest.dev",
      "oxc.rs",
      "pnpm.io",
      "docs.python.org",
      "docs.astral.sh",
      "numpy.org",
      "docs.scipy.org",
      "librosa.org",
      "python-soundfile.readthedocs.io",
      "ffmpeg.org",
      "www.itu.int",
      "www.ableton.com",
      "help.ableton.com",
      "docs.cycling74.com",
      "arxiv.org",
      "www.ietf.org",
      "www.rfc-editor.org"
    ],
    "tier2": ["cycling74.com", "blog.python.org", "devblogs.microsoft.com"]
  },
  "workarounds": {
    "ignorePaths": [".groundwork/bin/**"]
  }
}
