{
  "name": "@awh/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Runs quality-plan items through stateless Claude Code workers with deterministic checks and an evaluator loop",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
