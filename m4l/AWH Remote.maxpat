			{ "box": { "id": "obj-36", "maxclass": "message", "text": "call fire", "patching_rect": [ 1270.0, 330.0, 75.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-37", "maxclass": "message", "text": "prepend /awh/status fire", "patching_rect": [ 1270.0, 370.0, 175.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
