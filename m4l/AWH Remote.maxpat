{
	"patcher": {
		"fileversion": 1,
		"appversion": { "major": 8, "minor": 6, "revision": 0, "architecture": "x64", "modernui": 1 },
		"classnamespace": "box",
		"rect": [ 100.0, 100.0, 1400.0, 1480.0 ],
		"bglocked": 0,
		"openinpresentation": 0,
		"boxes": [
			{ "box": { "id": "obj-1", "maxclass": "comment", "text": "AWH Remote — transport + clip launch, OSC-driven (m4l/README.md). Supersedes AWH Capture Tap: same 9720/9721 ports, superset protocol. In: /awh/record <path>, /awh/stop, /awh/loop <startBeat> <lenBeats>, /awh/play <0|1>, /awh/ping, /awh/fire <trackIdx> <slotIdx>, /awh/scene <sceneIdx>, /awh/stopclips <trackIdx (-1=all)>, /awh/jump <beats>. Replies (fire/scene/stopclips/jump only): /awh/status <action> ..., /awh/error <text>.", "patching_rect": [ 30.0, 5.0, 1050.0, 40.0 ], "numinlets": 1, "numoutlets": 0 } },
			{ "box": { "id": "obj-2", "maxclass": "newobj", "text": "udpreceive 9720", "patching_rect": [ 30.0, 50.0, 110.0, 22.0 ], "numinlets": 1, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-3", "maxclass": "newobj", "text": "route /awh/record /awh/stop /awh/loop /awh/play /awh/ping /awh/fire /awh/scene /awh/stopclips /awh/jump", "patching_rect": [ 30.0, 85.0, 900.0, 22.0 ], "numinlets": 1, "numoutlets": 10, "outlettype": [ "", "", "", "", "", "", "", "", "", "" ] } },
			{ "box": { "id": "obj-4", "maxclass": "newobj", "text": "udpsend 127.0.0.1 9721", "patching_rect": [ 30.0, 1440.0, 150.0, 22.0 ], "numinlets": 1, "numoutlets": 0 } },
			{ "box": { "id": "obj-5", "maxclass": "newobj", "text": "t b s", "patching_rect": [ 30.0, 130.0, 45.0, 22.0 ], "numinlets": 1, "numoutlets": 2, "outlettype": [ "bang", "" ] } },
			{ "box": { "id": "obj-6", "maxclass": "message", "text": "prepend open", "patching_rect": [ 95.0, 170.0, 90.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-7", "maxclass": "newobj", "text": "del 100", "patching_rect": [ 30.0, 170.0, 55.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "bang" ] } },
			{ "box": { "id": "obj-8", "maxclass": "message", "text": "1", "patching_rect": [ 30.0, 210.0, 29.5, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-9", "maxclass": "message", "text": "0", "patching_rect": [ 150.0, 130.0, 29.5, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-10", "maxclass": "newobj", "text": "sfrecord~ 2", "patching_rect": [ 30.0, 250.0, 80.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "signal" ] } },
			{ "box": { "id": "obj-11", "maxclass": "newobj", "text": "plugin~", "patching_rect": [ 200.0, 210.0, 55.0, 22.0 ], "numinlets": 1, "numoutlets": 2, "outlettype": [ "signal", "signal" ] } },
			{ "box": { "id": "obj-12", "maxclass": "newobj", "text": "plugout~", "patching_rect": [ 200.0, 290.0, 62.0, 22.0 ], "numinlets": 2, "numoutlets": 2, "outlettype": [ "signal", "signal" ] } },
			{ "box": { "id": "obj-13", "maxclass": "newobj", "text": "unpack 0. 0.", "patching_rect": [ 230.0, 130.0, 80.0, 22.0 ], "numinlets": 1, "numoutlets": 2, "outlettype": [ "float", "float" ] } },
			{ "box": { "id": "obj-14", "maxclass": "message", "text": "set loop_start $1", "patching_rect": [ 230.0, 170.0, 105.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-15", "maxclass": "newobj", "text": "t b f", "patching_rect": [ 320.0, 170.0, 45.0, 22.0 ], "numinlets": 1, "numoutlets": 2, "outlettype": [ "bang", "float" ] } },
			{ "box": { "id": "obj-16", "maxclass": "message", "text": "set loop_length $1", "patching_rect": [ 320.0, 210.0, 112.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-17", "maxclass": "message", "text": "set loop 1", "patching_rect": [ 440.0, 210.0, 66.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-18", "maxclass": "newobj", "text": "sel 1 0", "patching_rect": [ 520.0, 130.0, 50.0, 22.0 ], "numinlets": 3, "numoutlets": 3, "outlettype": [ "bang", "bang", "" ] } },
			{ "box": { "id": "obj-19", "maxclass": "message", "text": "call start_playing", "patching_rect": [ 520.0, 170.0, 105.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-20", "maxclass": "message", "text": "call stop_playing", "patching_rect": [ 585.0, 210.0, 103.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-21", "maxclass": "message", "text": "/awh/pong 2", "patching_rect": [ 660.0, 130.0, 80.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-22", "maxclass": "newobj", "text": "loadbang", "patching_rect": [ 740.0, 50.0, 60.0, 22.0 ], "numinlets": 1, "numoutlets": 1, "outlettype": [ "bang" ] } },
			{ "box": { "id": "obj-23", "maxclass": "newobj", "text": "live.path live_set", "patching_rect": [ 740.0, 85.0, 105.0, 22.0 ], "numinlets": 1, "numoutlets": 3, "outlettype": [ "", "", "" ] } },
			{ "box": { "id": "obj-24", "maxclass": "newobj", "text": "live.object", "patching_rect": [ 520.0, 250.0, 75.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-25", "maxclass": "button", "patching_rect": [ 860.0, 85.0, 20.0, 20.0 ], "numinlets": 1, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-26", "maxclass": "comment", "text": "MANUAL RE-INIT — click after any reload/paste (loadbang won't refire; live.path silently breaks otherwise, same lesson as AWH Ducker.maxpat).", "patching_rect": [ 890.0, 88.0, 460.0, 20.0 ], "numinlets": 1, "numoutlets": 0 } },
			{ "box": { "id": "obj-27", "maxclass": "comment", "text": "FIRE: /awh/fire <trackIdx> <slotIdx> -> live_set tracks $1 clip_slots $2, call fire", "patching_rect": [ 1050.0, 105.0, 480.0, 18.0 ], "numinlets": 1, "numoutlets": 0 } },
			{ "box": { "id": "obj-28", "maxclass": "newobj", "text": "t l l", "patching_rect": [ 1050.0, 130.0, 45.0, 22.0 ], "numinlets": 1, "numoutlets": 2, "outlettype": [ "", "" ] } },
			{ "box": { "id": "obj-29", "maxclass": "newobj", "text": "unpack 0 0", "patching_rect": [ 1050.0, 170.0, 70.0, 22.0 ], "numinlets": 1, "numoutlets": 2, "outlettype": [ "int", "int" ] } },
			{ "box": { "id": "obj-30", "maxclass": "newobj", "text": "expr (($i1 < 0) || ($i2 < 0)) ? 2 : 1", "patching_rect": [ 1050.0, 210.0, 230.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "int" ] } },
			{ "box": { "id": "obj-31", "maxclass": "newobj", "text": "gate 2", "patching_rect": [ 1050.0, 250.0, 50.0, 22.0 ], "numinlets": 2, "numoutlets": 2, "outlettype": [ "", "" ] } },
			{ "box": { "id": "obj-32", "maxclass": "newobj", "text": "t l l", "patching_rect": [ 1050.0, 290.0, 45.0, 22.0 ], "numinlets": 1, "numoutlets": 2, "outlettype": [ "", "" ] } },
			{ "box": { "id": "obj-33", "maxclass": "message", "text": "live_set tracks $1 clip_slots $2", "patching_rect": [ 1050.0, 330.0, 200.0, 22.0 ], "numinlets": 2, "numoutlets": 1, "outlettype": [ "" ] } },
			{ "box": { "id": "obj-34", "maxclass": "newobj", "text": "live.path", "patching_rect": [ 1050.0, 370.0, 90.0, 22.0 ], "numinlets": 1, "numoutlets": 3, "outlettype": [ "", "", "" ] } },
